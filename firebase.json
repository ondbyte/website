{
  "hosting": {
    "site": "ondbyte-website",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/website/:file*",
        "destination": "/pre-ai/website/:file",
        "type": 301
      }
    ]
  }
}
